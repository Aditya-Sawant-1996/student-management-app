{
  "name": "student-management-app",
  "version": "0.0.0",
  "main": "main.js",
  "build": {
    "appId": "com.studentmanagement.app",
    "productName": "Student Management",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/student-management-app/browser",
        "to": "ui"
      }
    ],
    "directories": {
      "output": "release"
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "cross-env ELECTRON_DEV=true electron .",
    "watch": "ng build --configuration development --base-href ./ --watch",
    "build": "ng build --configuration production --base-href ./",
    "electron": "npm run build && electron .",
    "package:exe": "npm i && npm run build && electron-builder --win"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@angular/material": "^17.3.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "xlsx": "^0.18.5",
    "bootstrap": "^4.6.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.6",
    "@angular/cli": "^17.3.6",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.19",
    "electron": "^38.2.2",
    "electron-builder": "^25.0.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.19",
    "cross-env": "^7.0.3",
    "typescript": "~5.4.2"
  }
}
